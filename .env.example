# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real keys.

# Required. Paid API key from https://console.anthropic.com/
# This is NOT your Claude subscription. Each scan costs a few cents.
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended. Without it GitHub allows 60 requests/hour,
# which a single scan can exhaust.
# Create at https://github.com/settings/tokens - no scopes needed.
GITHUB_TOKEN=ghp_...
